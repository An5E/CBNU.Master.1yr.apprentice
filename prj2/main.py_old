import numpy as np
import pandas as pd
import torch
from torch.utils.data import TensorDataset, DataLoader
from sklearn.preprocessing import StandardScaler
from recurrentForecaster import RecurrentForecaster

df = pd.read_csv("./assets/ETTm2.csv", parse_dates=["date"])
df = df.sort_values("date").reset_index(drop=True)
target_col = "OT"
feature_cols = ["HUFL", "MUFL", "LUFL", "OT"] # 실제 컬럼에 맞게 수정
# 시간순으로 먼저 분할: 미래 데이터가 학습에 섞이지 않도록 함
values = df[feature_cols].to_numpy(dtype=np.float32)
target_idx = feature_cols.index(target_col)
n = len(values)
train_end = int(n * 0.60)
val_end = int(n * 0.80)
# 스케일러는 학습 구간에만 fit
x_scaler = StandardScaler().fit(values[:train_end])
scaled = x_scaler.transform(values).astype(np.float32)
# 입력 96시점, 예측 24시점
SEQ_LEN = 96
PRED_LEN = 24
BATCH_SIZE = 64

def make_windows(data, start, end, seq_len=96, pred_len=24):
    X, Y = [], []

    for t in range(start + seq_len, end - pred_len + 1):
        X.append(data[t-seq_len:t])
        Y.append(data[t:t+pred_len, target_idx])

    return (torch.tensor(np.asarray(X), dtype=torch.float32), torch.tensor(np.asarray(Y), dtype=torch.float32).unsqueeze(-1))


# 검증/테스트에서는 이전 구간의 관측값을 입력 문맥으로 허용
X_train, y_train = make_windows(scaled, 0, train_end)
X_val, y_val = make_windows(scaled, train_end - SEQ_LEN, val_end)
X_test, y_test = make_windows(scaled, val_end - SEQ_LEN, n)

train_loader = DataLoader(TensorDataset(X_train, y_train), batch_size=BATCH_SIZE, shuffle=True)
val_loader = DataLoader(TensorDataset(X_val, y_val), batch_size=BATCH_SIZE, shuffle=False)
test_loader = DataLoader(TensorDataset(X_test, y_test), batch_size=BATCH_SIZE, shuffle=False)

print(X_train.shape) # (샘플 수, 96, 변수 수)
print(y_train.shape) # (샘플 수, 24, 1)

input_size = X_train.shape[-1]

rnn = RecurrentForecaster("RNN", input_size=input_size, hidden_size=64, num_layers=2, pred_len=PRED_LEN, dropout=0.1)
lstm = RecurrentForecaster("LSTM", input_size=input_size, hidden_size=64, num_layers=2, pred_len=PRED_LEN, dropout=0.1)
gru = RecurrentForecaster("GRU", input_size=input_size, hidden_size=64, num_layers=2, pred_len=PRED_LEN, dropout=0.1)

print(rnn(X_train[:4]).shape) # (4, 24, 1)
print(lstm(X_train[:4]).shape) # (4, 24, 1)
print(gru(X_train[:4]).shape) # (4, 24, 1)